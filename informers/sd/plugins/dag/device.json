{
  "title": "My day (Mijn dag)",
  "description": "Weather, agenda and school news: today, or from 18:00 tomorrow, and the next two days",
  "config": {
    "file": "config.json"
  },
  "events": {
    "sleep.enter": {
      "download": [
        {
          "url": "{cfg.server}/dag.bmp?offset=0&kid={cfg.kid}&key={cfg.key}&lat={cfg.lat}&lon={cfg.lon}&depth={cfg.depth}&lang={cfg.lang}",
          "dest": "{cfg.dest_today}"
        },
        {
          "url": "{cfg.server}/dag.bmp?offset=1&kid={cfg.kid}&key={cfg.key}&lat={cfg.lat}&lon={cfg.lon}&depth={cfg.depth}&lang={cfg.lang}",
          "dest": "{cfg.dest_tomorrow}"
        },
        {
          "url": "{cfg.server}/dag.bmp?offset=2&kid={cfg.kid}&key={cfg.key}&lat={cfg.lat}&lon={cfg.lon}&depth={cfg.depth}&lang={cfg.lang}",
          "dest": "{cfg.dest_day_after}"
        }
      ],
      "refresh_minutes": 120,
      "wake": [
        "06:45",
        "07:55",
        "18:05",
        "19:05"
      ]
    }
  }
}
