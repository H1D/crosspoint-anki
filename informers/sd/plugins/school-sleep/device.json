{
  "title": "School news on sleep screen",
  "description": "School alarms on the sleep screen",
  "config": {
    "file": "config.json"
  },
  "events": {
    "sleep.enter": {
      "download": {
        "url": "{cfg.server}/school.bmp?kid={cfg.kid}&key={cfg.key}&depth={cfg.depth}&lang={cfg.lang}",
        "dest": "{cfg.dest}"
      },
      "refresh_minutes": 120,
      "wake": [
        "07:55",
        "19:05"
      ]
    }
  }
}
